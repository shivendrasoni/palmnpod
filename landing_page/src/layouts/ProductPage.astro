---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { Image } from 'astro:assets';

import logoRect from '../assets/logo-rectangle-cocoa.png';
import logoSeal from '../assets/logo-circular-oat.png';

interface Props {
  name: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  details: string[];
  allergens: string;
  productUrl: string;
  shareImage: string;
}

const { name, title, description, image, imageAlt, eyebrow, details, allergens, productUrl, shareImage } = Astro.props;
const WHATSAPP_NUMBER = '919730471041';
const orderUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hi, I want to place an order for the ${name}`)}`;
const canonicalUrl = Astro.site ? new URL(productUrl, Astro.site).href : `https://www.palmandpod.com${productUrl}`;
const imageUrl = Astro.site ? new URL(shareImage, Astro.site).href : shareImage;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Palm and Pod ${name}`,
  description,
  image: [imageUrl],
  brand: { '@type': 'Brand', name: 'Palm and Pod' },
  category: 'Food > Bakery > Brownies',
};
---

<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3a241e" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="product" />
    <meta property="og:title" content={`Palm and Pod ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1000" />
    <meta property="og:site_name" content="Palm and Pod" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Palm and Pod ${name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Palm and Pod home">
        <Image src={logoRect} widths={[240, 480, 720]} sizes="(max-width: 47.99rem) 150px, 196px" format="webp" alt="Palm and Pod" loading="eager" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/products/fudge-brownie/">Fudge brownie</a>
        <a href="/products/peanut-butter-brownie/">Peanut butter fudge</a>
      </nav>
    </header>

    <main id="main">
      <section class="product-hero" aria-labelledby="product-title">
        <Image class="product-hero__image" src={image} widths={[800, 1280, 1920, 2880]} sizes="100vw" formats={['avif', 'webp']} quality={78} alt={imageAlt} fetchpriority="high" />
        <div class="product-hero__shade"></div>
        <div class="product-hero__copy">
          {eyebrow && <p class="product-hero__eyebrow">{eyebrow}</p>}
          <h1 id="product-title">{title}</h1>
          <p>{description}</p>
          <a class="button" href={orderUrl} target="_blank" rel="noopener">Order on WhatsApp</a>
        </div>
      </section>

      <section class="product-details" aria-labelledby="details-title">
        <div>
          <p class="product-details__eyebrow">Made with care</p>
          <h2 id="details-title">The details, plainly.</h2>
        </div>
        <ul>
          {details.map((detail) => <li>{detail}</li>)}
        </ul>
        <aside aria-label="Allergen information">
          <h3>Allergens</h3>
          <p>{allergens}</p>
        </aside>
      </section>

      <section class="product-close">
        <p>Something good for the table, an afternoon break, or a quiet moment to yourself.</p>
        <a class="button button--light" href={orderUrl} target="_blank" rel="noopener">Order on WhatsApp</a>
      </section>
    </main>

    <footer class="footer">
      <Image class="footer__seal" src={logoSeal} widths={[120, 240]} sizes="96px" format="webp" alt="Palm and Pod" loading="lazy" />
      <p>Product images are for illustration.</p>
      <p>&copy; {new Date().getFullYear()} Palm and Pod</p>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 20; padding: .75rem 1rem; border-radius: 12px; background: var(--cocoa); color: var(--oat); font-weight: 600; }
  .skip:focus { top: 1rem; }
  .masthead { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: calc(env(safe-area-inset-top, 0px) + 1.25rem) var(--margin) 1rem; background: var(--oat-photo); }
  .wordmark :global(img) { width: clamp(9.375rem, 14vw, 12.25rem); height: auto; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem 1rem; font-size: .875rem; font-weight: 650; }
  .product-hero { position: relative; display: grid; min-height: min(50rem, calc(100svh - 5rem)); overflow: hidden; color: var(--oat); isolation: isolate; }
  .product-hero :global(.product-hero__image), .product-hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .product-hero :global(.product-hero__image) { object-fit: cover; object-position: 70% 50%; z-index: -2; }
  .product-hero__shade { z-index: -1; background: linear-gradient(90deg, rgb(42 25 20 / .72) 0%, rgb(42 25 20 / .42) 36%, transparent 68%); }
  .product-hero__copy { align-self: center; width: min(100% - (var(--margin) * 2), 38rem); margin-left: var(--margin); padding: 4rem 0; }
  .product-hero__eyebrow, .product-details__eyebrow { margin-bottom: .8rem; font-size: .8rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 10ch; font-size: clamp(3.15rem, 7vw, 6.5rem); line-height: .96; letter-spacing: -.035em; }
  .product-hero__copy > p:not(.product-hero__eyebrow) { max-width: 33rem; margin-top: 1.5rem; font-size: clamp(1.125rem, 1.7vw, 1.35rem); }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 3.5rem; margin-top: 2rem; padding: 0 1.6rem; border-radius: 14px; background: var(--oat); color: var(--cocoa); font-weight: 700; text-decoration: none; }
  .button:hover { background: #fff8ee; }
  .product-details { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr) minmax(16rem, .8fr); gap: clamp(2rem, 6vw, 6rem); max-width: var(--max); margin: 0 auto; padding: clamp(4rem, 10vw, 8rem) var(--margin); }
  .product-details h2 { font-size: clamp(2.4rem, 4vw, 4rem); line-height: 1; }
  .product-details ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .product-details li { padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  aside { align-self: start; padding: 1.5rem; background: var(--toffee-wash); border-radius: 18px; }
  aside h3 { font-size: 1.4rem; }
  .product-close { display: grid; place-items: center; min-height: 24rem; padding: 4rem var(--margin); text-align: center; background: var(--cocoa); color: var(--oat); }
  .product-close p { max-width: 36rem; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.75rem); line-height: 1.05; }
  .button--light { background: var(--oat); }
  .footer { display: grid; justify-items: center; gap: .5rem; padding: 3rem var(--margin); text-align: center; font-size: .875rem; background: var(--oat-photo); }
  .footer__seal { width: 6rem; height: auto; }
  @media (max-width: 50rem) { nav { max-width: 13rem; } .product-hero__shade { background: linear-gradient(90deg, rgb(42 25 20 / .72), rgb(42 25 20 / .15)); } .product-details { grid-template-columns: 1fr; } }
</style>
