---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { Image } from 'astro:assets';

import logoRect from '../assets/logo-rectangle-cocoa.png';
import logoSeal from '../assets/logo-circular-oat.png';

interface Props {
  name: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  details: string[];
  allergens: string;
  productUrl: string;
  shareImage: string;
}

const { name, title, description, image, imageAlt, eyebrow, details, allergens, productUrl, shareImage } = Astro.props;
const WHATSAPP_NUMBER = '919730471041';
const orderUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hi, I want to place an order for the ${name}`)}`;
const canonicalUrl = Astro.site ? new URL(productUrl, Astro.site).href : `https://www.palmandpod.com${productUrl}`;
const imageUrl = Astro.site ? new URL(shareImage, Astro.site).href : shareImage;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Palm and Pod ${name}`,
  description,
  image: [imageUrl],
  brand: { '@type': 'Brand', name: 'Palm and Pod' },
  category: 'Food > Bakery > Brownies',
};
---

<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3a241e" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="product" />
    <meta property="og:title" content={`Palm and Pod ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1000" />
    <meta property="og:site_name" content="Palm and Pod" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Palm and Pod ${name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Palm and Pod home">
        <Image src={logoRect} widths={[240, 480, 720]} sizes="(max-width: 47.99rem) 150px, 196px" format="webp" alt="Palm and Pod" loading="eager" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/products/fudge-brownie/">Fudge brownie</a>
        <a href="/products/peanut-butter-brownie/">Peanut butter fudge</a>
      </nav>
    </header>

    <main id="main">
      <section class="product-hero" aria-labelledby="product-title">
        <Image class="product-hero__image" src={image} widths={[800, 1280, 1920, 2880]} sizes="100vw" formats={['avif', 'webp']} quality={78} alt={imageAlt} fetchpriority="high" />
        <div class="product-hero__shade"></div>
        <div class="product-hero__copy">
          {eyebrow && <p class="product-hero__eyebrow">{eyebrow}</p>}
          <h1 id="product-title">{title}</h1>
          <p>{description}</p>
          <button class="button" type="button" data-open-order>Order on WhatsApp</button>
        </div>
      </section>

      <section class="product-details" aria-labelledby="details-title">
        <div>
          <p class="product-details__eyebrow">Made with care</p>
          <h2 id="details-title">The details, plainly.</h2>
        </div>
        <ul>
          {details.map((detail) => <li>{detail}</li>)}
        </ul>
        <aside aria-label="Allergen information">
          <h3>Allergens</h3>
          <p>{allergens}</p>
        </aside>
      </section>

      <section class="product-close">
        <p>Something good for the table, an afternoon break, or a quiet moment to yourself.</p>
        <button class="button button--light" type="button" data-open-order>Order on WhatsApp</button>
      </section>
    </main>
    <dialog class="order-modal" data-order-modal aria-labelledby="order-title">
      <div class="order-modal__head"><div><p class="product-details__eyebrow">Order on WhatsApp</p><h2 id="order-title">A few details, then we’ll take it from there.</h2></div><button class="order-modal__close" type="button" data-close-order aria-label="Close order form">×</button></div>
      <form class="order__form" data-order-form data-product={name} data-whatsapp-number={WHATSAPP_NUMBER}>
          <label>
            Your name
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            Mobile number
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
          </label>
          <label>
            Product
            <input value={name} readonly aria-readonly="true" />
          </label>
          <label>
            Quantity
            <select name="quantity" required>
              <option value="Box of 4">Box of 4</option>
              <option value="Box of 6">Box of 6</option>
              <option value="Box of 12">Box of 12</option>
            </select>
          </label>
          <button class="button order__submit" type="submit">Get my Fudge Now</button>
      </form>
    </dialog>

    <footer class="footer">
      <Image class="footer__seal" src={logoSeal} widths={[120, 240]} sizes="96px" format="webp" alt="Palm and Pod" loading="lazy" />
      <p>Product images are for illustration.</p>
      <p>&copy; {new Date().getFullYear()} Palm and Pod</p>
    </footer>
    <script>
      const modal = document.querySelector<HTMLDialogElement>('[data-order-modal]');
      document.querySelectorAll<HTMLButtonElement>('[data-open-order]').forEach((button) => button.addEventListener('click', () => modal?.showModal()));
      document.querySelector<HTMLButtonElement>('[data-close-order]')?.addEventListener('click', () => modal?.close());
      document.querySelectorAll<HTMLFormElement>('[data-order-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;

          const values = new FormData(form);
          const product = form.dataset.product ?? '';
          const number = form.dataset.whatsappNumber ?? '';
          const message = [
            'Hi, I would like to place an order.',
            `Name: ${values.get('name')}`,
            `Phone: ${values.get('phone')}`,
            `Product: ${product}`,
            `Quantity: ${values.get('quantity')}`,
          ].join('\n');
          modal?.close();
          window.open(`https://wa.me/${number}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
        });
      });
    </script>
  </body>
</html>
